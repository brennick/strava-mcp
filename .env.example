# Strava OAuth — only used to seed /data/tokens.json on the very first start.
# After that, the on-disk file is the source of truth (Strava rotates the
# refresh token on every refresh and the server persists the new value).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# imperial -> mi/ft/mph; metric -> km/m/kmh. Default imperial.
STRAVA_UNITS=imperial

# Optional: a password the "Approve" page on /authorize requires before issuing
# an OAuth code. Without this, anyone who guesses the public domain can complete
# the connector handshake and read your Strava data. STRONGLY recommended.
MCP_APPROVE_PASSWORD=

# Where the Strava token file lives inside the container. Bind-mount ./data:/data in compose.
STRAVA_TOKEN_PATH=/data/tokens.json

# Where the OAuth state lives (issued access/refresh tokens, registered clients).
OAUTH_STORE_PATH=/data/oauth.json

# Public hostname Caddy serves on (also used for the Let's Encrypt cert).
# Example: strava-mcp.example.com
DOMAIN=
